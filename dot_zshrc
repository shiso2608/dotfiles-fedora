# Created by newuser for 5.9
# ディスプレイの明るさをパーセンテージ（0-100）で一括設定する関数
set_brightness() {
    local percent="$1"

    if [[ -z "$percent" ]] || ! [[ "$percent" =~ ^[0-9]+$ ]] || (( percent < 0 || percent > 100 )); then
        echo "使用方法: bright <0-100>"
        return 1
    fi

    # Display 1 (max 50) 用にスケーリング計算 (0-100% -> 0-50)
    local val1=$(( percent * 50 / 100 ))
    # Display 2 (max 100) 用の値
    local val2=$percent

    echo "明るさを $percent% に設定中... (Disp1: $val1/50, Disp2: $val2/100)"
    
    # 並列実行で高速化
    ddcutil --display 1 setvcp 10 "$val1" >/dev/null 2>&1
    ddcutil --display 2 setvcp 10 "$val2" >/dev/null 2>&1
    
    echo "設定が完了しました。"
}

alias bright="set_brightness"
